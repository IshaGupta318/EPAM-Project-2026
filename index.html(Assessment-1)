<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0">

    <title>XYZ Bank Festival Coupon</title>

    <style>

       *{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    background:#f2f5f9;
    font-family:Arial, Helvetica, sans-serif;
    color:#333;
    padding:35px 15px;
}

.container{
    width:100%;
    max-width:700px;
    margin:auto;
    background:#ffffff;
    padding:30px;
    border-radius:10px;
    border:1px solid #dcdcdc;
    box-shadow:0 4px 10px rgba(0,0,0,0.10);
}

h1{
    text-align:center;
    color:#0d47a1;
    margin-bottom:15px;
}

.description{
    text-align:center;
    line-height:1.6;
    color:#555;
    margin-bottom:25px;
}

#welcomeBox{
    background:#fff3cd;
    color:#856404;
    border:1px solid #ffe082;
    padding:15px;
    border-radius:6px;
    text-align:center;
    font-weight:bold;
    margin-bottom:25px;
    cursor:pointer;
}



#instructionBox{
    background:#f8f9fa;
    border:1px solid #d6d6d6;
    padding:20px;
    border-radius:8px;
}

#instructionBox h2{
    color:#1565c0;
    margin-bottom:15px;
}

#instructionBox ol{
    margin-left:22px;
}

#instructionBox li{
    margin-bottom:10px;
    line-height:1.5;
}



#customerPanel{
    display:none;
    margin-top:25px;
}

#customerPanel h2{
    color:#1565c0;
    margin-bottom:18px;
}

label{
    display:block;
    margin-bottom:8px;
    font-weight:bold;
}

input{
    width:100%;
    padding:12px;
    border:1px solid #bdbdbd;
    border-radius:6px;
    margin-bottom:18px;
    font-size:15px;
}

input:focus{
    outline:none;
    border-color:#1976d2;
}


.buttonArea{
    text-align:center;
}

button{
    background:#1976d2;
    color:white;
    border:none;
    padding:11px 20px;
    margin:6px;
    border-radius:6px;
    font-size:15px;
    cursor:pointer;
}

button:hover{
    background:#0d47a1;
}

button:disabled{
    background:#9e9e9e;
    cursor:not-allowed;
}



#message{
    display:none;
    margin-top:20px;
    padding:15px;
    border-radius:6px;
    font-weight:bold;
    line-height:1.5;
}

.success{
    display:block;
    background:#d4edda;
    color:#155724;
    border:1px solid #7bc67e;
}

.error{
    display:block;
    background:#f8d7da;
    color:#721c24;
    border:1px solid #e89aa3;
}



@media (max-width:600px){

    .container{
        padding:20px;
    }

    button{
        width:100%;
        margin:8px 0;
    }
}

    </style>

    <script>

       

var alertShown = false;




function initializePage() {

    var box = document.getElementById("welcomeBox");

    box.addEventListener("mouseover", showWelcome);
}




function showWelcome() {

    if (alertShown == false) {

        alert("Welcome to XYZ Bank Festival Rewards!");

        alertShown = true;
    }
}




function showMessage(text, type) {

    var msg = document.getElementById("message");

    msg.innerHTML = text;

    msg.className = type;

    msg.style.display = "block";
}




function registerUser() {

    document.getElementById("instructionBox").style.display = "none";

    document.getElementById("customerPanel").style.display = "block";

    var btn = document.getElementById("registerBtn");

    btn.innerHTML = "Registered";

    btn.disabled = true;

    showMessage(
        "Registration completed successfully.",
        "success"
    );

    document.getElementById("customerId").focus();
}



function getCustomerId() {

    var id = document.getElementById("customerId").value;

    id = id.trim();

    id = id.toUpperCase();

    return id;
}




function verifyCustomer() {

    var id = getCustomerId();

    if (id == "") {

        showMessage(
            "Please enter your Customer ID.",
            "error"
        );

        return;
    }

    if (id.startsWith("XYZ")) {

        showMessage(
            "Customer ID verified successfully.",
            "success"
        );
    }

    else {

        showMessage(
            "Customer ID is not valid.",
            "error"
        );
    }
}




function generateCoupon() {

    var id = getCustomerId();

    if (id == "") {

        showMessage(
            "Enter Customer ID before generating a coupon.",
            "error"
        );

        return;
    }

    if (id.startsWith("XYZ")) {

        var coupon = "XYZ-" + id + "-2026";

        showMessage(
            "Congratulations! Your Coupon Code is : " + coupon,
            "success"
        );
    }

    else {

        showMessage(
            "Coupon cannot be generated because the Customer ID is invalid.",
            "error"
        );
    }
}




function resetForm() {

    document.getElementById("customerId").value = "";

    var msg = document.getElementById("message");

    msg.innerHTML = "";

    msg.className = "";

    msg.style.display = "none";

    document.getElementById("customerId").focus();
}

    </script>

</head>

<body onload="initializePage()">

    <div class="container">

        <h1>XYZ Bank Festival Rewards</h1>

        <p class="description">
            Welcome to the XYZ Bank Festival Rewards Portal.
            Existing customers can register, verify their Customer ID,
            and receive a special festival coupon.
        </p>

        <div id="welcomeBox">
            Move your mouse over this message to receive a welcome greeting.
        </div>

        <div id="instructionBox">

            <h2>How to Apply</h2>

            <ol>

                <li>Click on the Register button.</li>

                <li>Enter your Customer ID.</li>

                <li>Verify your Customer ID.</li>

                <li>Generate your Festival Coupon.</li>

            </ol>

            <button
                id="registerBtn"
                type="button"
                onclick="registerUser()">

                Register

            </button>

        </div>

        <div id="customerPanel">

            <h2>Customer Verification</h2>

            <label for="customerId">

                Customer ID

            </label>

            <input
                type="text"
                id="customerId"
                placeholder="Example : XYZ1025"
                autocomplete="off">

            <div class="buttonArea">

                <button
                    type="button"
                    onclick="verifyCustomer()">

                    Verify

                </button>

                <button
                    type="button"
                    onclick="generateCoupon()">

                    Generate Coupon

                </button>

                <button
                    type="button"
                    onclick="resetForm()">

                    Reset

                </button>

            </div>

        </div>

        <div id="message"></div>

    </div>

</body>

</html>
